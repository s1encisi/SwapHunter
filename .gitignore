# Publish source and portable documentation only. Local artifacts stay on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Game/
!/Tools/
!/docs/

/Game/*
!/Game/Assets/
!/Game/Packages/
!/Game/ProjectSettings/
!/Game/THIRD_PARTY_NOTICES.md

/Tools/*
!/Tools/ArtAuthoring/
!/Tools/Build-Demo-v03.ps1
/Tools/ArtAuthoring/*
!/Tools/ArtAuthoring/generate-assets.mjs
!/Tools/ArtAuthoring/package.json
!/Tools/ArtAuthoring/package-lock.json
!/Tools/ArtAuthoring/README.md

/docs/*
!/docs/system-design-v03.md
!/docs/v03-modules.csv
!/docs/v03-contracts.csv
!/docs/validation.md
!/docs/media/

**/node_modules/
**/Library/
**/Temp/
**/Obj/
**/Logs/
**/UserSettings/
**/MemoryCaptures/
**/Recordings/
**/.vs/
**/.idea/
**/.vscode/
**/.env
**/.env.*
**/*.user
**/*.suo
**/*.csproj
**/*.sln
**/*.log
**/*.tmp
**/*.bak
**/*.pfx
**/*.p12
**/*.key
**/.DS_Store
**/Thumbs.db
